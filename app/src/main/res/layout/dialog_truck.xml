<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/truck_title"
            android:textColor="@color/primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPlate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_edit"
            android:hint="@string/plate_hint"
            android:inputType="textCapCharacters"
            android:padding="12dp" />

        <!-- 车型 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/car_size"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        <Spinner
            android:id="@+id/spnSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etLength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="@string/vehicle_length"
                android:inputType="numberDecimal"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etWidth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="@string/vehicle_width"
                android:inputType="numberDecimal"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etHeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="@string/vehicle_height"
                android:inputType="numberDecimal"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etAxis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="@string/vehicle_axis"
                android:inputType="number"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="@string/vehicle_weight"
                android:inputType="numberDecimal"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etLoad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="@string/vehicle_load"
                android:inputType="numberDecimal"
                android:padding="12dp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbAvoidRestrict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/avoid_restrict" />

        <CheckBox
            android:id="@+id/cbLoadSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/load_switch" />

    </LinearLayout>
</ScrollView>
